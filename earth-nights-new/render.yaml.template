services:
  - type: web
    name: earth-nights-api
    env: node
    buildCommand: npm install
    startCommand: npm start
    envVars:
      - key: PG_USER
        value: <your_postgres_user>
      - key: PG_PASSWORD
        value: <your_postgres_password>
      - key: PG_HOST
        value: <your_postgres_host>
      - key: PG_PORT
        value: 5432
      - key: PG_DATABASE
        value: earth_nights
      - key: NODE_ENV
        value: production
      - key: CORS_ORIGIN
        value: <your_frontend_url> 